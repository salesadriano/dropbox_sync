{
  "permissions": {
    "allow": [
      "Bash(gh pr merge *)",
      "Bash(gh run rerun *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/scripts/resumo-de-estado.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/scripts/guarda-de-comandos.sh --padroes \"$CLAUDE_PROJECT_DIR\"/scripts/guarda-de-comandos.txt",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
