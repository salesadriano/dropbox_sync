        printf '  --padrao, --pattern <glob>      Nome dos artefatos (obrigatorio, um so)\n'
        printf '  --manter, --keep <n>            Mantem os n mais novos (1 a 999999)\n'
        printf '  --dias, --days <d>              Mantem os de ate d dias (1 a 36500)\n'
        printf '  --confirmar, --yes, -y          Aplica o plano (sem ela, nada e apagado)\n\n'
        printf 'sem --confirmar nada e apagado: o comando so mostra o plano (fica/sai) e sai\n'
        printf 'com 0; com --dry-run, idem, mesmo com --confirmar. Nenhuma pergunta e feita.\n'
        printf 'sempre mantem pelo menos 1 artefato.\n'
        printf 'so o nivel de cima da pasta e so arquivos; o padrao casa o nome, sem diferenciar maiusculas\n'
        printf '(glob dos filtros: *, ?, [...], \; sem /). Pastas, subpastas e arquivos fora\n'
        printf 'do padrao nunca sao apagados, so contados. --manter e --dias sao excludentes.\n'
        printf 'o mais novo e o de data do servidor mais recente; em empate, o de maior nome\n'
        printf '(server_modified; client_modified e tamanho nao contam). restaurar ou regravar um artefato antigo o torna o mais novo.\n'
        printf 'os apagados vao para a lixeira e podem ser recuperados com dbx restaurar dentro do prazo do plano da conta\n'
        printf '(veja dbx lixeira <pasta>). Cada exclusao leva o rev listado: um backup novo de\n'
        printf 'mesmo nome que chegue no meio nao e apagado (conflito, codigo 14).\n'
        printf -- '--dias compara a data do servidor com o relogio desta maquina; divergencia\n'
        printf 'acima de 300 s do cabecalho Date da listagem sai com codigo 3, sem apagar nada.\n\n'
        printf 'Codigos: 0 (inclusive plano e nada a apagar), 2, 3, 4 (pasta inexistente), 5,\n'
        printf '8, 9, 10 (listagem ou resposta incoerente, nada apagado), 13, 14 (falha parcial,\n'
        printf 'reset ou sinal). Sem trava e sem estado local.\n\n'
        printf 'Exemplos:\n'
        printf '  dbx reter /backups --padrao '"'"'db-*.tar.gz'"'"' --manter 7\n'
        printf '  dbx upload ... && dbx reter /backups --padrao '"'"'db-*.tar.gz'"'"' --manter 7 --confirmar\n'
        exit 0
        ;;
      perfis)
        printf 'Uso: dbx perfis\n\n'
        printf 'Lista os perfis de credencial (o padrao e perfis/<nome>.json) e se cada um esta\n'
        printf 'completo, um registro por perfil e um total no fim: perfil, credencial (completa,\n'
        printf 'incompleta, ilegivel, permissao ou ligacao_simbolica), ativo (sim ou nao) e arquivo.\n'
        printf 'Alias em ingles: profiles.\n\n'
        printf 'Nunca imprime segredo nem a identidade da credencial; so le, sem rede e sem criar nada.\n'
        printf 'Codigo de saida: 0 (inclusive perfil quebrado e nenhum perfil); 2 uso invalido;\n'
        printf '3 so sem diretorio de configuracao.\n\n'
        printf 'Selecao do perfil (todos os comandos): --perfil <nome> (alias --profile) ANTES do\n'
        printf 'comando, ou depois dele so em config e unlink; a variavel DBX_PERFIL carrega SO o\n'
        printf 'nome (nunca segredo) e a opcao vence. Sem nenhuma das duas vale o perfil padrao.\n'
        printf 'Perfil inexistente sai com codigo 3, sem rede e sem recuar para o padrao.\n'
        printf 'O unlink de um perfil nao apaga o estado de outro; com a mesma credencial em dois\n'
        printf 'perfis ele nao revoga o token. Dois sync --receber na mesma raiz local sao\n'
        printf 'recusados (codigo 7), qualquer que seja o perfil.\n'
        exit 0
        ;;
      diagnostico)
        printf 'Uso: dbx diagnostico\n\n'
        printf 'Checa dependencias, credencial, conectividade, escopos, espaco, localidade, o\n'
        printf 'diretorio de estado e as travas de sync/verificar, uma linha por checagem (ok,\n'
        printf 'aviso ou falha) com o remedio.\n'
        printf 'Alias em ingles: doctor.\n\n'
        printf 'Nao passa pela verificacao previa, nunca imprime segredo e nao altera nada.\n'
        printf 'O diagnostico nao inicia o config nem oferece corrigir; para testar a rede e a\n'
        printf 'credencial com a oferta do config, use dbx testar.\n'
        printf 'Codigo de saida: 0 sem falha (aviso nao reprova); 3 com ao menos uma falha.\n'
        exit 0
        ;;
      testar)
        printf 'Uso: dbx testar\n\n'
        printf 'Testa a disponibilidade, nesta ordem: internet (sonda neutra), servico Dropbox\n'
        printf '(api e content, sem token) e credencial (campos locais e uma renovacao do token).\n'
        printf 'Uma linha por checagem (ok, aviso ou falha) com o remedio; a dependente de uma\n'
        printf 'falha sai como nao executada. Alias em ingles: check. Valem --json e --null.\n\n'
        printf 'Codigo de saida: 0 sem falha; senao o da primeira falha: 9 sem internet ou Dropbox\n'
        printf 'inacessivel, 10 servico indisponivel (5xx), 8 limite de taxa, 3 credencial ausente\n'
        printf 'ou incompleta, 5 credencial recusada.\n\n'
        printf 'Sonda: GET sem token em https://www.gstatic.com/generate_204 (servidor de\n'
        printf 'terceiro; qualquer resposta HTTP conta). DBX_TESTE_INTERNET_URL troca o endereco\n'
        printf '(so https://); definida e vazia desliga a sonda; invalida sai com 2.\n\n'
        printf 'Com terminal interativo, credencial ausente ou invalida oferece o dbx config\n'
        printf '([s/N]) e, configurado, refaz as checagens; DBX_TESTE_CONFIG=nao desliga a oferta.\n'
        printf 'Nao altera nada alem disso. O diagnostico nao inicia o config.\n'
        exit 0
        ;;
      completar)
        printf 'Uso: dbx completar bash\n\n'
        printf 'Imprime o script de autocompletar do bash (o mesmo de completions/dbx.bash).\n'
        printf 'Alias em ingles: completion.\n\n'
        printf 'Para ativar na sessao corrente:  source <(dbx completar bash)\n'
        printf 'O install.sh ja o instala em ~/.local/share/bash-completion/completions/dbx.\n'
        exit 0
        ;;
      *)
        printf 'Uso: dbx [--json] [--null] [--dry-run] [--progresso] [--debug] <comando> [argumentos]\n\n'
        printf 'Comandos:\n'
        printf '  config       Configura credenciais de acesso via OAuth2\n'
        printf '  unlink       Revoga credencial e remove estado local\n'
        printf '  sync         Sincroniza diretorio local e remoto (--enviar ou --receber)\n'
        printf '  upload       Envia arquivo local ou entrada padrao (-) para o Dropbox\n'
        printf '  download     Baixa arquivo remoto para caminho local ou stdout\n'
        printf '  list         Lista conteudo de diretorio remoto\n'
        printf '  delete       Remove arquivo ou diretorio remoto\n'
        printf '  info         Exibe metadados de arquivo ou pasta remota\n'
        printf '  space        Exibe capacidade e uso do espaco da conta\n'
        printf '  verificar    Compara local e remoto por content_hash, so leitura (alias: verify)\n'
        printf '  diagnostico  Checa o ambiente e sugere o remedio (alias: doctor)\n'
        printf '  testar       Testa internet, servico Dropbox e credencial (alias: check)\n'
        printf '  completar    Imprime o autocompletar do bash (alias: completion)\n'
        printf '  revisoes     Lista as revisoes de um arquivo (alias: revisions)\n'
        printf '  restaurar    Restaura revisao de arquivo ou pasta apagada (alias: restore)\n'
        printf '  lixeira      Lista apagados; --excluir expurga em definitivo (alias: trash)\n'
        printf '  link-temporario  URL direta de download valida por 4 horas\n'
        printf '  temp-link    Alias em ingles de link-temporario\n'
        printf '  compartilhar Cria, lista ou revoga link compartilhado (alias: share)\n'
        printf '  reter        Mantem os backups mais novos e apaga o resto (alias: retain)\n'
        printf '  perfis       Lista os perfis de credencial e se estao completos (alias: profiles)\n\n'
        printf 'Opcoes globais: --help -h --version -V --json --null --dry-run --progresso --progress -p --sem-progresso --no-progress --debug --perfil --profile\n\n'
        printf 'Ajuda especifica por comando: dbx help <comando>\n\n'
        printf 'Com --debug (ou DBX_DEBUG=1), upload, download e sync escrevem em stderr linhas "debug: <categoria>\n'
        printf 'chave=valor" (categorias http, upload, download, sync e resumo), nunca com token, segredo,\n'
        printf 'id de sessao, cursor, URL temporaria ou query.\n\n'
        printf 'Perfil de credencial (--perfil <nome>, alias --profile): vale para todos os comandos; a\n'
        printf 'variavel DBX_PERFIL carrega so o nome (nunca segredo) e a opcao vence. Veja dbx help perfis.\n\n'
        # RNF-07, RNF-30: os ajustes de rede sao documentados onde o operador os
        # procura; valor invalido e recusado com codigo 2 antes da rede.
        printf 'Variaveis de ambiente de rede (inteiro positivo; invalido sai com codigo 2):\n'
        printf '  DBX_HTTP_CONNECT_TIMEOUT_S      tempo para conectar, em s (padrao 15)\n'
        printf '  DBX_HTTP_VELOCIDADE_MINIMA_BPS  corte abaixo desta velocidade, em B/s (padrao 1024)\n'
        printf '  DBX_HTTP_VELOCIDADE_JANELA_S    ...mantida por esta janela, em s (padrao 60)\n'
        printf '  DBX_HTTP_TENTATIVAS_MAXIMAS     tentativas, contando a primeira (padrao 5)\n'
        printf '  DBX_HTTP_ESPERA_BASE_MS         base do recuo exponencial, em ms (padrao 1000)\n'
        printf '  DBX_HTTP_ESPERA_TETO_MS         teto de cada espera, em ms (padrao 60000)\n'
        printf '  DBX_HTTP_RETRY_AFTER_TETO_S     teto do Retry-After do servidor, em s (padrao 300)\n\n'
        printf 'Variavel de ambiente do perfil (so o NOME, nunca segredo; vazia vale como nao definida):\n'
        printf '  DBX_PERFIL                      perfil de credencial; --perfil vence (padrao: perfil padrao)\n\n'
        printf 'Credencial ausente ou invalida (comandos que exigem credencial, exceto config, perfis,\n'
        printf 'diagnostico, testar, unlink, completar, help e version): com stdin e stderr em terminal\n'
        printf 'o dbx pergunta "Configurar agora? [s/N]". DBX_TESTE_CONFIG=nao desliga a pergunta. Falha\n'
        printf 'de rede na renovacao do token nomeia a causa (sem internet ou Dropbox inacessivel).\n\n'
        printf 'Recomendacao para upload de fluxo (RSK-36):\n'
        printf '  Em "dbx upload - <destino>", ative "set -o pipefail" no shell do operador ao usar pipes.\n'
        exit 0
        ;;
    esac
    ;;
esac

# PERFIL (fase 8, RF-120, RF-121, RF-128): a selecao vale para todo comando que
# resolve credencial; `help`, `version` e `completar` nunca leem `DBX_PERFIL`.
# Nome invalido sai 2 ANTES de qualquer acesso a disco e de rede.
if [[ $DBX_CLI_COMANDO != 'completar' ]]; then
  dbx_cli_perfil_aplicar || _dbx_falhar uso_invalido "$DBX_CLI_MOTIVO"
  if [[ ${DBX_CONFIG_PERFIL_ORIGEM:-} == 'ambiente' ]]; then
    printf 'aviso: perfil ativo %s (DBX_PERFIL)\n' "$DBX_CONFIG_PERFIL" >&2
  fi
fi

_dbx_arquivo=$(_dbx_cli_arquivo_do_comando "$DBX_CLI_COMANDO") ||
  _dbx_falhar uso_invalido "comando sem implementacao: $DBX_CLI_COMANDO"
[[ -r $_dbx_arquivo ]] ||
  _dbx_falhar uso_invalido "comando ainda nao implementado: $DBX_CLI_COMANDO"

# shellcheck source=/dev/null
. "$_dbx_arquivo"

_dbx_requisito=$("dbx_cmd_${DBX_CLI_COMANDO}_requisitos")
case $_dbx_requisito in
  nenhum) ;;
  ambiente | credencial)
    # shellcheck source=lib/preflight.sh
    . "$DBX_CLI_RAIZ/lib/preflight.sh"
    # O NIVEL VIAJA: sem ele, `ambiente` herdaria a recusa por permissao de
    # credencial e o assistente de configuracao nao rodaria justamente quando a
    # credencial esta errada, que e quando ele existe para ser usado.
    dbx_preflight_verificar "$_dbx_requisito" ||
      _dbx_falhar configuracao "$(dbx_preflight_mensagem)"
    if [[ $_dbx_requisito == 'credencial' ]]; then
      dbx_carregar_camada_de_credencial
      # shellcheck source=/dev/null # ver dbx_iniciar_config
      . "$DBX_CLI_RAIZ/lib/disponibilidade.sh"
      _dbx_disponibilidade_preparar "${DBX_CLI_ARGS[@]:-}"
      if ! dbx_config_carregar; then
        # RF-151(b), RF-152: credencial ausente ou incompleta pode receber a oferta
        # do `config`; recusa, cancelamento ou falha mantem a recusa de sempre.
        _dbx_mensagem=$(dbx_config_mensagem_de_indisponibilidade)
        case $DBX_CONFIG_MOTIVO in
          permissao | permissao_diretorio | ligacao_simbolica) _dbx_causa='' ;;
          ausente) _dbx_causa='ausente' ;;
          *) _dbx_causa='invalida' ;;
        esac
        if [[ -n $_dbx_causa ]] && dbx_disp_oferecer_config "$_dbx_causa" && dbx_config_carregar; then
          :
        else
          _dbx_falhar configuracao "$_dbx_mensagem"
        fi
      fi
    fi
    ;;
  *) _dbx_falhar uso_invalido "requisito nao reconhecido: $_dbx_requisito" ;;
esac

# RF-162: resumo no termino de download, upload e sync, tambem em falha e sinal.
if [[ ${DBX_CLI_DEBUG:-nao} == 'sim' ]]; then
  case $DBX_CLI_COMANDO in
    download | upload | sync)
      # shellcheck source=/dev/null
      . "$DBX_CLI_RAIZ/lib/debug.sh"
      dbx_debug_canal_abrir
      dbx_debug_resumo_armar "$DBX_CLI_COMANDO"
      ;;
  esac
fi

"dbx_cmd_${DBX_CLI_COMANDO}_executar" "${DBX_CLI_ARGS[@]:-}"
