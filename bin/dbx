#!/usr/bin/env bash
# dbx — ponto de entrada unico.
#
# Deliberadamente fino: interpreta opcoes globais, aplica a verificacao previa
# que o comando declarou precisar e despacha. Nenhuma regra de negocio mora
# aqui.
set -u

# RAIZ DO PROJETO ANTES DO DESPACHO, SO COM O SHELL (RF-66(e), RNF-02)
#
#   Nada aqui pode depender de utilitario externo: o `diagnostico` precisa
#   rodar justamente quando falta um deles, e o preflight precisa chegar a
#   nomear o que falta. O diretorio sai por expansao de parametro (`${x%/*}`,
#   no lugar de `dirname`) e `cd -P`/`pwd -P`, que sao do shell.
#
#   LIMITE DECLARADO: o shell nao le o alvo de um vinculo simbolico. Quando o
#   `dbx` e chamado pelo vinculo que o `install.sh` cria, o alvo e lido por
#   `readlink` e, na falta dele, por `find -printf %l`; sem os dois, a recusa e
#   explicita e nomeia o que instalar. Chamar `bin/dbx` pelo caminho real nao
#   depende de nenhum dos dois.
_dbx_fonte=${BASH_SOURCE[0]}
_dbx_saltos=0
while [[ -L $_dbx_fonte ]]; do
  _dbx_saltos=$((_dbx_saltos + 1))
  [[ $_dbx_saltos -le 40 ]] || {
    printf 'dbx: vinculos simbolicos demais ate o ponto de entrada: %s\n' "${BASH_SOURCE[0]}" >&2
    exit 3
  }
  _dbx_dir=${_dbx_fonte%/*}
  [[ $_dbx_dir == "$_dbx_fonte" ]] && _dbx_dir=.
  _dbx_dir=$(cd -P -- "${_dbx_dir:-/}" && pwd -P)
  if command -v readlink >/dev/null 2>&1; then
    _dbx_fonte=$(readlink -- "$_dbx_fonte")
  elif command -v find >/dev/null 2>&1; then
    _dbx_fonte=$(find "$_dbx_fonte" -maxdepth 0 -printf '%l')
  else
    printf 'dbx: o ponto de entrada e vinculo simbolico (%s) e nem readlink nem find estao disponiveis para resolve-lo; instale o utilitario readlink ou chame %s pelo caminho real\n' \
      "${BASH_SOURCE[0]}" 'bin/dbx' >&2
    exit 3
  fi
  [[ $_dbx_fonte != /* ]] && _dbx_fonte="$_dbx_dir/$_dbx_fonte"
done
_dbx_dir=${_dbx_fonte%/*}
[[ $_dbx_dir == "$_dbx_fonte" ]] && _dbx_dir=.
DBX_CLI_RAIZ=$(cd -P -- "${_dbx_dir:-/}/.." && pwd -P)
export DBX_CLI_RAIZ
unset _dbx_fonte _dbx_dir _dbx_saltos

# shellcheck source=lib/errors.sh
. "$DBX_CLI_RAIZ/lib/errors.sh"
# shellcheck source=lib/path.sh
. "$DBX_CLI_RAIZ/lib/path.sh"
# shellcheck source=lib/output.sh
. "$DBX_CLI_RAIZ/lib/output.sh"
# shellcheck source=lib/progress.sh
. "$DBX_CLI_RAIZ/lib/progress.sh"
# shellcheck source=lib/cli.sh
. "$DBX_CLI_RAIZ/lib/cli.sh"

# dbx_carregar_camada_de_credencial — sourcing dos componentes que lidam com a
# credencial e com a rede autenticada.
#
# UM SO LUGAR ENUMERA A LISTA. Ela e usada por dois caminhos diferentes:
#
#   - o nivel `credencial`, logo abaixo, que carrega E EXIGE credencial valida;
#   - os comandos `config` e `unlink`, que declaram o nivel `ambiente` porque
#     precisam funcionar SEM credencial valida — um para grava-la, outro para
#     remove-la — mas ainda assim precisam dos mesmos componentes.
#
# Duplicar a lista faria a proxima dependencia nova entrar num caminho e nao no
# outro, com sintoma de funcao inexistente longe da causa. Os componentes tem
# guarda de carga unica, entao chamar isto duas vezes e inofensivo.
dbx_carregar_camada_de_credencial() {
  # shellcheck source=lib/json.sh
  . "$DBX_CLI_RAIZ/lib/json.sh"
  # shellcheck source=lib/config.sh
  . "$DBX_CLI_RAIZ/lib/config.sh"
  # shellcheck source=lib/http.sh
  . "$DBX_CLI_RAIZ/lib/http.sh"
  # shellcheck source=lib/auth.sh
  . "$DBX_CLI_RAIZ/lib/auth.sh"
  # shellcheck source=lib/cmd.sh
  . "$DBX_CLI_RAIZ/lib/cmd.sh"
  # RNF-30(c), RNF-07(e): ajuste de rede invalido para a execucao ANTES de
  # qualquer chamada, inclusive a renovacao do token, com a variavel e o valor
  # no diagnostico. `lib/http` repete a guarda em cada requisicao; aqui ela so
  # ganha a mensagem que o comando nao saberia dar.
  dbx_http_validar_ambiente || _dbx_falhar uso_invalido "$DBX_HTTP_MOTIVO_AMBIENTE"
}

# dbx_iniciar_config [args] — roda o `config` no mesmo processo (RF-152(f)). Mora
# aqui, e nao em lib/, porque lib nao carrega commands/ (DIV-325).
dbx_iniciar_config() {
  # source=/dev/null: com a cadeia de commands/config.sh e lib/disponibilidade.sh, o lint de bin/dbx
  # passa do teto de 12 GB; os dois tem lint proprio, como os comandos do despacho.
  # shellcheck source=/dev/null
  . "$DBX_CLI_RAIZ/commands/config.sh"
  dbx_cmd_config_executar "$@"
}

# _dbx_disponibilidade_preparar <argumentos...> — arma o gancho de RF-151(c) e
# fecha o portao da oferta para o comando que consome a entrada padrao (DIV-315:
# origem `-` e as opcoes de senha por stdin ou terminal).
_dbx_disponibilidade_preparar() {
  local argumento
  dbx_auth_registrar_ganchos dbx_disp_ao_falhar_token dbx_disp_ao_falhar_chamada
  # shellcheck disable=SC2034 # DBX_DISP_CONSOME_STDIN e lida por lib/disponibilidade.sh
  for argumento in "$@"; do
    case $argumento in
      - | --senha | --password | --senha-stdin | --password-stdin) DBX_DISP_CONSOME_STDIN='sim' ;;
    esac
  done
}

_dbx_falhar() {
  local classe=$1 texto=$2
  dbx_output_iniciar
  [[ $DBX_CLI_ESTRUTURADA == 'sim' ]] && dbx_output_modo estruturada
  [[ $DBX_CLI_NULO == 'sim' ]] && dbx_output_terminador nulo
  dbx_output_diagnostico erro "$texto"
  dbx_output_render_diagnostico >&2
  exit "$(dbx_errors_codigo_saida "$classe")"
}

# Trechos de ajuda comuns a mais de um comando (RF-83): uma fonte so, para o
# texto de `sync`, `verificar`, `download` e `upload` nao divergir.
_dbx_ajuda_filtros() {
  printf '%s\n' \
    'Filtros de caminho (RF-79, RF-80; sintaxe do .gitignore, sem caixa):' \
    '  O padrao e comparado com o caminho relativo a raiz, nos dois lados. Sem /, casa' \
    '  o nome em qualquer nivel (*.log); / no inicio ou no meio ancora na raiz' \
    '  (/build, doc/a.txt); / no fim casa so pasta e tudo abaixo dela (cache/).' \
    '  * nao cruza /; ? e um caractere; [abc], [a-z], [!0-9]; ** no inicio (**/tmp),' \
    '  no fim (build/**) ou no meio (a/**/b) cruza pastas; \ torna literal o seguinte.' \
    '  --excluir e --incluir sao repetiveis e acumulam; a exclusao vence a inclusao;' \
    '  com algum --incluir, so o que casa entra. Pasta excluida nao e percorrida.' \
    '  Desvios do gitignore: sem ! (use --incluir), # e espaco final sao literais,' \
    '  classe [[:alpha:]] e recusada; ate 64 padroes de ate 1024 bytes.' \
    '  item filtrado nunca e apagado no espelhamento; remover um filtro devolve os itens ao escopo' \
    '  (e eles voltam a seguir a regra normal, inclusive a exclusao do --espelhar).' \
    '  A comparacao NAO normaliza Unicode: NFC e NFD sao grafias distintas (um e' \
    '  acentuado composto nao casa o decomposto), e o item numa grafia que o padrao' \
    '  nao casa fica no escopo, inclusive para a exclusao do --espelhar (RF-79(h)).' \
    '  Exemplos: --excluir '"'"'*.tmp'"'"' --excluir cache/   |   --incluir '"'"'*.pdf'"'"''
}

_dbx_ajuda_data_tamanho() {
  printf '%s\n' \
    'Filtros de data e tamanho (RF-81; so arquivos da ORIGEM, pastas sempre percorridas):' \
    '  Data AAAA-MM-DD ou AAAA-MM-DDTHH:MM:SSZ (UTC), limites inclusivos; o dia sozinho' \
    '  vale 00:00:00 no --modificado-desde e 23:59:59 no --modificado-ate. Local: mtime;' \
    '  remoto: server_modified (quando o Dropbox recebeu a versao). Tamanho em bytes ou' \
    '  com K, M ou G (base 1024), limites inclusivos. Junto de --espelhar sao recusados' \
    '  (codigo 2): avaliam so a origem e fariam o espelhamento apagar no destino.'
}

_dbx_ajuda_banda() {
  printf '%s\n' \
    'Limite de banda (RF-82):' \
    '  --limite-banda TAXA (alias --bwlimit) em bytes/s (numero sem sufixo e bytes/s,' \
    '  nao KiB/s como no rsync), com K, M ou G em base 1024. Piso: 2 x' \
    '  DBX_HTTP_VELOCIDADE_MINIMA_BPS (2048 bytes/s no padrao). Sem a opcao, vale a' \
    '  variavel DBX_LIMITE_BANDA; a opcao vence. Para desligar o padrao numa chamada:' \
    '  env -u DBX_LIMITE_BANDA dbx ... O limite vale por transferencia (so conteudo);' \
    '  duas execucoes simultaneas somam.'
}

# _dbx_ajuda_retomada — RF-108(c) (fase 7a, F-03), a mesma em upload e download.
_dbx_ajuda_retomada() {
  # shellcheck disable=SC2016  # o nome da variavel e texto literal da ajuda
  printf '%s\n' \
    'Retomada (F-03), para arquivo acima de 150 MiB (nao vale para pasta, entrada ou' \
    'saida padrao, sync nem --dry-run):' \
    '  - uma transferencia grande interrompida continua de onde parou na proxima execucao com os mesmos argumentos;' \
    '  - o upload so continua se o arquivo local nao mudou; ao final, o content_hash e conferido;' \
    '  - o destino so muda depois de conferido o content_hash (o parcial do download' \
    '    fica junto do destino: .<nome>.dbx-part.XXXXXX, 0600);' \
    '  - use --sem-retomada para comecar do zero.' \
    '  O estado fica em $XDG_STATE_HOME/dbx (retomada-*, 0600, sem segredo); apaga-lo' \
    '  a mao (e o parcial) so faz a proxima execucao recomecar do zero.'
}

dbx_cli_analisar "$@" || _dbx_falhar uso_invalido "$DBX_CLI_MOTIVO"

if [[ ${#DBX_CLI_ARGS[@]} -gt 0 ]]; then
  for _dbx_arg in "${DBX_CLI_ARGS[@]}"; do
    if [[ $_dbx_arg == '--help' || $_dbx_arg == '-h' ]]; then
      DBX_CLI_ARGS=("$DBX_CLI_COMANDO")
      DBX_CLI_COMANDO='help'
      break
    fi
  done
fi

case $DBX_CLI_COMANDO in
  version)
    printf 'dbx %s\n' "$DBX_CLI_VERSAO"
    exit 0
    ;;
  help)
    # O alias em ingles mostra a mesma ajuda do nome em portugues.
    dbx_cli_canonico "${DBX_CLI_ARGS[0]:-}"
    _dbx_subcomando=$DBX_CLI_CANONICO
    case $_dbx_subcomando in
      upload)
        printf 'Uso: dbx upload [--modo add|overwrite] [--rev <rev>] [--forcar | --force] [--limite-banda | --bwlimit <taxa>] [--sem-retomada | --no-resume] [--progresso] <origem> <destino>\n\n'
        printf 'Com --debug (global, ou DBX_DEBUG=1): uma linha "debug: <categoria> chave=valor" por evento,\n'
        printf 'so em stderr; categorias http, upload e resumo (no fim). Nunca mostra token, segredo, id de\n'
        printf 'sessao, cursor, URL temporaria nem query. stdout, codigos de saida e requisicoes nao mudam.\n\n'
        printf 'Envia arquivo local ou conteudo da entrada padrao (-) para o caminho remoto.\n\n'
        printf 'Argumentos:\n'
        printf '  origem   Caminho de arquivo local ou "-" para entrada padrao (stdin)\n'
        printf '  destino  Caminho remoto no Dropbox (/pasta/arquivo)\n\n'
        printf 'Opcoes:\n'
        printf '  --modo, --mode <add|overwrite>  Modo de escrita (padrao: add)\n'
        printf '  --rev <rev>                     Revisao esperada para controle de conflito\n'
        printf '  --forcar, --force               Pula as checagens previas: comparacao por\n'
        printf '                                  content_hash e espaco livre da conta\n'
        printf '  --limite-banda, --bwlimit <taxa>\n'
        printf '                                  Limite de banda por transferencia, em bytes/s\n'
        printf '  --sem-retomada, --no-resume     Comeca do zero: nao le, nao grava nem apaga o\n'
        printf '                                  estado de retomada\n'
        printf '  --progresso, --progress, -p     Exibe progresso da operacao em stderr\n'
        printf '                                  Por arquivo: [i/N] acao: item [barra] percentual feitos / total; no terminal a linha e reescrita no lugar, sem terminal cada atualizacao e uma linha nova\n'
        printf '  --sem-progresso, --no-progress  Desativa exibicao de progresso\n\n'
        _dbx_ajuda_banda
        printf '\n'
        _dbx_ajuda_retomada
        printf '\n'
        printf 'Espaco livre (RF-67):\n'
        printf '  Antes de enviar, uma consulta ao espaco da conta; se o arquivo nao cabe, o\n'
        printf '  envio e recusado com codigo 12, sem escrever nada. Com --dry-run, so avisa.\n'
        printf '  A entrada padrao (-) nao e checada. Falha na consulta so avisa.\n\n'
        printf 'Recomendacao operacional (RSK-36):\n'
        printf '  Ao enviar pela entrada padrao via encadeamento (pipe):\n'
        printf '    tar czf - /dados | dbx upload - /destino.tgz\n'
        printf '  Recomenda-se ativar "set -o pipefail" no shell do operador para garantir que\n'
        printf '  falhas prematuras do processo produtor sejam detectadas pelo encadeamento.\n'
        exit 0
        ;;
      config)
        printf 'Uso: dbx config [--perfil | --profile <nome>] [--substituir | --replace] [--raiz | --root <caminho>] [--debug]\n\n'
        printf 'Configura credencial e pareamento com a conta do Dropbox via fluxo OAuth2 offline.\n'
        printf 'Sem --perfil grava o perfil padrao (credencial.json); com --perfil <nome> cria\n'
        printf 'perfis/<nome>.json (veja dbx help perfis). O nome pode vir antes ou depois de config.\n\n'
        printf 'Opcoes:\n'
        printf '  --perfil, --profile <nome>      Perfil da credencial (1 a 32 de a-z, 0-9, _ e -)\n'
        printf '  --substituir, --replace         Troca a credencial existente (o token antigo NAO e revogado)\n'
        printf '  --raiz, --root <caminho>        Raiz remota gravada na credencial (padrao: /)\n'
        printf '  --debug                         Diagnostico do ambiente em stderr\n\n'
        printf 'Oferta automatica: nos comandos que exigem credencial, com stdin e stderr em terminal,\n'
        printf 'credencial ausente ou invalida pergunta "Configurar agora? [s/N]" (padrao: nao); aceito\n'
        printf 'e o config ok, o comando continua com os mesmos argumentos. Recusa ou falha mantem o\n'
        printf 'codigo de sempre (3 ou 5). DBX_TESTE_CONFIG=nao desliga a oferta; sem terminal, com\n'
        printf '--dry-run ou em comando que le a entrada padrao (upload -) nao ha pergunta.\n'
        exit 0
        ;;
      unlink)
        printf 'Uso: dbx unlink [--perfil | --profile <nome>] [--confirmar | --yes] [--manter-aplicativo | --keep-app]\n\n'
        printf 'Revoga o vinculo com a conta remota e limpa a credencial local.\n'
        printf 'Com sync ou verificar em curso neste host, recusa com codigo 7 sem apagar nada;\n'
        printf 'trava orfa, ilegivel ou de outro host fica, com um aviso por trava.\n\n'
        printf 'Opcoes:\n'
        printf '  --perfil, --profile <nome>      Desvincula so este perfil (o nome pode vir antes ou depois de unlink)\n'
        printf '  --confirmar, --yes              Confirma o desvinculo sem terminal interativo\n'
        printf '  --manter-aplicativo, --keep-app Preserva app key e app secret para religar\n'
        exit 0
        ;;
      sync)
        printf 'Uso: dbx sync (--enviar | --push | --receber | --pull) (--origem | --source) <dir> (--destino | --dest) <dir> [--espelhar | --mirror] [--confirmar | --yes] [--permitir-origem-vazia | --allow-empty-source] [--forcar | --force] [--esperar | --wait <s>] [--excluir <padrao>]... [--incluir <padrao>]... [--modificado-desde <data>] [--modificado-ate <data>] [--tamanho-min <tam>] [--tamanho-max <tam>] [--limite-banda <taxa>] [--paralelo <n>] [--sem-cursor | --no-cursor | --varredura-completa | --full-scan] [--progresso]\n\n'
        printf 'Com --debug (global, ou DBX_DEBUG=1): uma linha "debug: <categoria> chave=valor" por evento,\n'
        printf 'so em stderr; categorias http, sync, upload, download e resumo (no fim). Nunca mostra token,\n'
        printf 'segredo, id de sessao, cursor, URL temporaria nem query. stdout, codigos de saida e\n'
        printf 'requisicoes nao mudam.\n\n'
        printf 'Sincroniza diretorio local e remoto de forma direcional com a origem como autoridade.\n\n'
        printf 'Opcoes (o nome em ingles e alias do nome em portugues; podem ser misturados):\n'
        printf '  --enviar, --push                Origem local, destino remoto\n'
        printf '  --receber, --pull               Origem remota, destino local\n'
        printf '  --origem, --source <dir>        Lado que manda (obrigatorio)\n'
        printf '  --destino, --dest <dir>         Lado que recebe (obrigatorio)\n'
        printf '  --espelhar, --mirror            Apaga no destino o que nao existe na origem\n'
        printf '  --confirmar, --yes              Reconhece a primeira execucao com --espelhar\n'
        printf '  --permitir-origem-vazia, --allow-empty-source\n'
        printf '                                  Permite espelhar uma origem VAZIA (apaga o destino)\n'
        printf '  --forcar, --force               So com --enviar: pula a checagem de espaco livre\n'
        printf '  --esperar, --wait <s>           Espera ate <s> segundos (0 a 3600) pela trava do par\n'
        printf '  --excluir, --exclude <padrao>   Tira do escopo o que casa (repetivel; veja Filtros)\n'
        printf '  --incluir, --include <padrao>   So o que casa entra no escopo (repetivel)\n'
        printf '  --modificado-desde, --modified-since <data>\n'
        printf '                                  So arquivos da origem modificados desde a data\n'
        printf '  --modificado-ate, --modified-until <data>\n'
        printf '                                  So arquivos da origem modificados ate a data\n'
        printf '  --tamanho-min, --min-size <tam> So arquivos da origem com ao menos <tam>\n'
        printf '  --tamanho-max, --max-size <tam> So arquivos da origem com no maximo <tam>\n'
        printf '  --limite-banda, --bwlimit <taxa>\n'
        printf '                                  Limite de banda por transferencia, em bytes/s\n'
        printf '  --paralelo, --parallel <n>      Transferencias simultaneas (1 a 8, padrao 1); veja Paralelismo\n'
        printf '  --progresso, --progress, -p     Exibe progresso da operacao em stderr\n'
        printf '                                  Por arquivo: [i/N] acao: item [barra] percentual feitos / total; no terminal a linha e reescrita no lugar, sem terminal cada atualizacao e uma linha nova\n'
        printf '  --sem-progresso, --no-progress  Desativa exibicao de progresso\n'
        printf '  --sem-cursor, --no-cursor       So com --receber: nao usa o registro de listagem\n'
        printf '  --varredura-completa, --full-scan\n'
        printf '                                  So com --receber: refaz a varredura e o registro\n\n'
        _dbx_ajuda_filtros
        printf '  O plano traz filtros=sim, os padroes e filtrados_origem/filtrados_destino\n'
        printf '  (pasta excluida conta 1); origem toda filtrada conta como vazia (RF-41).\n\n'
        _dbx_ajuda_data_tamanho
        printf '\n'
        _dbx_ajuda_banda
        printf '\n'
        printf 'Paralelismo (F-09):\n'
        printf '  --paralelo N (alias --parallel) ou DBX_PARALELO=N, de 1 a 8 (padrao 1; a opcao\n'
        printf '  vence a variavel), roda ate N transferencias de arquivo ao mesmo tempo, no\n'
        printf '  envio e no recebimento. A listagem e as exclusoes seguem em sequencia; o\n'
        printf '  resultado, o cache, o resumo, a ordem das linhas e o codigo de saida sao os de\n'
        printf '  N=1. --limite-banda e o teto TOTAL: cada transferencia leva a taxa dividida por\n'
        printf '  N (nunca abaixo do piso). N maior pode provocar mais respostas 429: cada\n'
        printf '  processo respeita o Retry-After, N nao diminui sozinho, e --debug informa\n'
        printf '  quantas houve. --dry-run nunca usa paralelismo. Valor invalido sai com 2.\n\n'
        printf 'Trava de concorrencia (RF-69):\n'
        printf '  Um sync ou verificar por vez para o mesmo par (conta, raiz local, raiz remota,\n'
        printf '  em qualquer sentido), inclusive com --dry-run. Ocupada, a execucao e recusada\n'
        printf '  na hora com codigo 7, dizendo pid, host, inicio e comando de quem a tem; com\n'
        printf '  --esperar N ela tenta a cada segundo por ate N segundos. Trava de processo\n'
        printf '  morto neste host e retomada com aviso; de outro host ou ilegivel, nunca: o\n'
        printf '  dbx diagnostico mostra o arquivo e como libera-lo.\n\n'
        printf 'Cursor de listagem (--receber, F-14):\n'
        printf '  O cursor so acelera a listagem remota; sem registro, com registro invalido\n'
        printf '  ou vencido, a varredura completa roda sozinha. O registro guarda o cursor e\n'
        printf '  um retrato da arvore remota no diretorio de estado (0600); a execucao seguinte\n'
        printf '  pede ao servidor so o que mudou, e a arvore local e sempre percorrida inteira.\n'
        printf '  Uma exclusao local so e feita depois de o servidor confirmar que o arquivo foi\n'
        printf '  apagado. Use --varredura-completa para refazer o registro e --sem-cursor para\n'
        printf '  nao usa-lo. A varredura completa e obrigatoria a cada 7 dias ou 100 execucoes.\n'
        printf '  O plano traz varredura (incremental ou completa), cursor_motivo, cursor_mudancas\n'
        printf '  e cursor_confirmadas; o cursor em si nunca aparece. O --enviar, o verificar e o\n'
        printf '  download de pasta nao usam o registro. Juntas, ou fora do --receber, as duas\n'
        printf '  opcoes saem com codigo 2.\n\n'
        printf 'Repeticao: opcao com valor vale o ultimo valor dado; opcao sem valor e\n'
        printf '  idempotente; um segundo sentido (--enviar/--push/--receber/--pull) e recusado.\n\n'
        printf 'Origem vazia (RF-41):\n'
        printf '  Com --espelhar, origem vazia (--enviar: raiz local sem nenhum arquivo;\n'
        printf '  --receber: listagem remota vazia) e algo a apagar no destino e recusada\n'
        printf '  inteira, antes de qualquer escrita, haja ou nao memoria do par: o plano sai\n'
        printf '  com "recusada=origem vazia" e o codigo e 14. So --permitir-origem-vazia libera;\n'
        printf '  --confirmar nao basta. Com --dry-run, o plano anuncia "recusaria", nao lista\n'
        printf '  exclusoes e sai com 0. Sem --espelhar, origem vazia e operacao vazia.\n\n'
        printf 'Localidade (RF-54):\n'
        printf '  A comparacao sem caixa usa C.UTF-8 quando existe; sem ela, vale so no ASCII\n'
        printf '  e o sync avisa uma vez em stderr, sem recusar.\n\n'
        printf 'Espaco livre (RF-67):\n'
        printf '  No --enviar, a soma dos arquivos a transferir e conferida com o espaco livre\n'
        printf '  da conta numa unica consulta; se nao cabe, o plano sai e a execucao e recusada\n'
        printf '  com codigo 12 antes de qualquer escrita. Com --dry-run, o plano so avisa.\n\n'
        printf 'Aviso (RF-52):\n'
        printf '  Se a identificacao da conta falhar, o sync segue sem memoria auxiliar: com\n'
        printf '  --espelhar, as exclusoes ficam DESABILITADAS naquela execucao (envios e\n'
        printf '  recebimentos seguem), o motivo sai no relatorio e o codigo de saida e diferente\n'
        printf '  de 0. --confirmar NAO reabilita as exclusoes; sem ele, a primeira execucao com\n'
        printf '  --espelhar continua pedindo reconhecimento.\n'
        exit 0
        ;;
      download)
        printf 'Uso: dbx download [--excluir <padrao>]... [--incluir <padrao>]... [--limite-banda <taxa>] [--sem-retomada | --no-resume] [--progresso] <caminho_remoto> [destino_local]\n\n'
        printf 'Com --debug (global, ou DBX_DEBUG=1): uma linha "debug: <categoria> chave=valor" por evento,\n'
        printf 'so em stderr; categorias http, download e resumo (no fim). Nunca mostra token, segredo, id de\n'
        printf 'sessao, cursor, URL temporaria nem query. stdout, codigos de saida e requisicoes nao mudam.\n\n'
        printf 'Baixa arquivo remoto para caminho local ou para a saida padrao (quando omitido ou "-").\n'
        printf 'Pasta remota e recebida recursivamente (o sync --receber interno).\n\n'
        printf 'Opcoes:\n'
        printf '  --excluir, --exclude <padrao>   So pasta: tira do escopo o que casa (repetivel)\n'
        printf '  --incluir, --include <padrao>   So pasta: so o que casa e recebido (repetivel)\n'
        printf '  --modificado-desde, --modified-since <data>\n'
        printf '                                  So pasta: arquivos modificados desde a data\n'
        printf '  --modificado-ate, --modified-until <data>\n'
        printf '                                  So pasta: arquivos modificados ate a data\n'
        printf '  --tamanho-min, --min-size <tam> So pasta: arquivos com ao menos <tam>\n'
        printf '  --tamanho-max, --max-size <tam> So pasta: arquivos com no maximo <tam>\n'
        printf '  --limite-banda, --bwlimit <taxa>\n'
        printf '                                  Limite de banda por transferencia, em bytes/s\n'
        printf '  --progresso, --progress, -p     Exibe progresso da operacao em stderr\n'
        printf '                                  Por arquivo: [i/N] acao: item [barra] percentual feitos / total; no terminal a linha e reescrita no lugar, sem terminal cada atualizacao e uma linha nova\n'
        printf '  --sem-progresso, --no-progress  Desativa exibicao de progresso\n'
        printf '  --forcar, --force               Aceita e sem efeito, por paridade com o upload\n'
        printf '  --sem-retomada, --no-resume     Comeca do zero: nao le, nao grava nem apaga o\n'
        printf '                                  estado de retomada nem arquivo parcial\n\n'
        _dbx_ajuda_retomada
        printf '\n'
        printf 'Os filtros valem so para pasta: com um arquivo remoto, a recusa e codigo 2,\n'
        printf 'sem nenhuma escrita (o tipo e consultado antes, por get_metadata).\n\n'
        _dbx_ajuda_filtros
        printf '\n'
        _dbx_ajuda_data_tamanho
        printf '\n'
        _dbx_ajuda_banda
        exit 0
        ;;
      list)
        printf 'Uso: dbx list [--limite <n>] [--recursivo] <caminho_remoto>\n\n'
        printf 'Lista o conteudo de pasta remota com paginacao automatica.\n\n'
        printf 'Opcoes:\n'
        printf '  --limite, --limit <n>           Itens por pagina pedidos ao servico\n'
        printf '  --recursivo, --recursive, -R    Inclui o conteudo das subpastas\n'
        exit 0
        ;;
      delete)
        printf 'Uso: dbx delete [--confirmar | --yes] [--rev <rev>] <caminho_remoto>\n\n'
        printf 'Remove arquivo ou pasta no Dropbox.\n\n'
        printf 'Opcoes:\n'
        printf '  --confirmar, --yes, -y          Confirma a remocao sem terminal interativo\n'
        printf '  --rev <rev>                     Revisao esperada para controle de conflito\n'
        exit 0
        ;;
      info)
        printf 'Uso: dbx info <caminho_remoto>\n\n'
        printf 'Exibe metadados de arquivo ou pasta remota.\n'
        exit 0
        ;;
      space)
        printf 'Uso: dbx space [--humano | -H]\n\n'
        printf 'Exibe capacidade total e espaco utilizado na conta Dropbox.\n\n'
        printf 'Opcoes:\n'
        printf '  --humano, --human, -H           Acrescenta os valores em unidade legivel\n'
        exit 0
        ;;
      verificar)
        printf 'Uso: dbx verificar (--enviar | --push | --receber | --pull) (--origem | --source) <dir> (--destino | --dest) <dir> [--esperar | --wait <s>] [--excluir <padrao>]... [--incluir <padrao>]... [--progresso]\n\n'
        printf 'Compara a arvore local e a remota por content_hash, sem transferir nem gravar nada.\n'
        printf 'Alias em ingles: verify.\n\n'
        printf 'Opcoes (as mesmas do sync; o nome em ingles e alias do nome em portugues):\n'
        printf '  --enviar, --push                Origem local, destino remoto\n'
        printf '  --receber, --pull               Origem remota, destino local\n'
        printf '  --origem, --source <dir>        Lado de referencia (obrigatorio)\n'
        printf '  --destino, --dest <dir>         Lado comparado (obrigatorio)\n'
        printf '  --esperar, --wait <s>           Espera ate <s> segundos (0 a 3600) pela trava do par\n'
        printf '  --excluir, --exclude <padrao>   Nao compara o que casa (repetivel; veja Filtros)\n'
        printf '  --incluir, --include <padrao>   So compara o que casa (repetivel)\n'
        printf '  --progresso, --progress, -p     Exibe progresso da operacao em stderr\n'
        printf '  --sem-progresso, --no-progress  Desativa exibicao de progresso\n\n'
        _dbx_ajuda_filtros
        printf '  Filtrado nao e comparado e nunca conta como divergencia. Filtros de data e\n'
        printf '  tamanho e --limite-banda sao recusados (codigo 2): o verificar so le.\n\n'
        printf 'Cada arquivo sai uma vez como igual, diferente, so_origem ou so_destino, com as\n'
        printf 'contagens ao fim. Codigo de saida: 0 tudo igual; 11 ha divergencia; 14 travessia\n'
        printf 'parcial; erro de execucao (rede, autenticacao, ...) prevalece. As opcoes do sync que\n'
        printf 'escrevem (--espelhar, --confirmar, --permitir-origem-vazia, --forcar) sao recusadas.\n'
        printf 'Trava o par como o sync (codigo 7 se ocupada; veja dbx help sync); o arquivo de\n'
        printf 'trava e a unica escrita e sai no fim.\n'
        exit 0
        ;;
      revisoes)
        printf 'Uso: dbx revisoes [--limite <n>] [--por-id] <arquivo_remoto>\n\n'
        printf 'Lista as revisoes de um arquivo, da mais recente para a mais antiga, inclusive\n'
        printf 'de arquivo apagado. Alias em ingles: revisions. So leitura.\n\n'
        printf 'Opcoes (o nome em ingles e alias do nome em portugues):\n'
        printf '  --limite, --limit <n>           Revisoes pedidas, de 1 a 100 (padrao 10)\n'
        printf '  --por-id, --by-id               Segue o arquivo atraves de movimentos (mode=id)\n\n'
        printf 'Cada revisao traz os campos de dbx info; ao fim, apagado, apagado_em, mais e\n'
