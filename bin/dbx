        exit 0
        ;;
      restaurar)
        printf 'Uso: dbx restaurar [--rev <rev> | --antes-de <data>] <caminho_remoto>\n\n'
        printf 'Restaura uma revisao de arquivo, inclusive de arquivo apagado, ou uma pasta\n'
        printf 'apagada inteira, arquivo por arquivo. Alias em ingles: restore.\n\n'
        printf 'Opcoes (o nome em ingles e alias do nome em portugues):\n'
        printf '  --rev <rev>                     Revisao do proprio arquivo (veja dbx revisoes)\n'
        printf '  --antes-de, --before <data>     A revisao mais recente ate a data (UTC):\n'
        printf '                                  AAAA-MM-DD (fim do dia) ou AAAA-MM-DDTHH:MM:SSZ\n\n'
        printf 'Arquivo apagado sem --rev nem --antes-de volta na ultima revisao; arquivo vivo\n'
        printf 'exige um dos dois. Restaurar sobre arquivo existente e direto: a versao atual\n'
